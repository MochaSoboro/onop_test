package aaa.control;

import java.util.Map;

import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

import aaa.JwtUtil;
import aaa.model.LoginDTO;

@RestController
public class LoginController {
	
	private final JwtUtil jwtUtil;
	
	public LoginController(JwtUtil jwtUtil) {
		this.jwtUtil = jwtUtil;
	}

	@PostMapping("/login")
	Map<String, String> login(@RequestBody LoginDTO dto) {
		System.out.println("백엔드 로그인 진입: "+dto);
		
		if (dto.getPid().equals("aaa") && dto.getPw().equals("1111")) {
			String token = jwtUtil.createToken(dto.getPid());
			
			
			return Map.of("token", token);
		}
		
		return Map.of("token", "aaaa");
	}
}
