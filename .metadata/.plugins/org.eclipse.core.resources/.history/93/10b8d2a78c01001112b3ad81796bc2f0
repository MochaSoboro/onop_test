package aaa;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;

// @SpringBootTest 없음
public class NumberTest {
			// @SpringBootTest 없음
	@Test	// 단위 테스트시에는 Spring 실행하지 않음 - 처리 속도가 빠르다
	void tt1() {
		System.out.println("숫자 tt1 진입");
		assertThat(20).isGreaterThan(10);	// 20 > 10
		assertThat(20).isGreaterThan(20);	// 20 > 20	에러
		assertThat(20).isGreaterThan(30);	// 20 > 30	에러
	}
	
	@Test
	void tt2() {
		System.out.println("숫자 tt2 진입");
		assertThat(20).isGreaterThanOrEqualTo(20);	// 20 >= 20
		assertThat(20).isGreaterThanOrEqualTo(30);	// 20 >= 30
	}
	
	@Test
	void tt3() {
		System.out.println("숫자 tt3 진입");
		assertThat(20).isLessThan(30);	// 20 < 30
		assertThat(20).isLessThanOrEqualTo(20);	// 20 <= 20
	}
	
	@Test
	void tt4() {
		System.out.println("숫자 tt4 진입");
		assertThat(7).isBetween(5, 10);		// 5 <= 7 <= 10
		assertThat(5).isBetween(5, 10);		// 5 <= 5 <= 10
		assertThat(10).isBetween(5, 10);	// 5 <= 10 <= 10
		assertThat(11).isBetween(5, 10);	// 5 <= 11 <= 10
	}
	
	@Test
	void tt5() {
		System.out.println("숫자 tt5 진입");
		assertThat(7).isPositive();		// 양수인가? n > 0
		assertThat(0).isPositive();		// 에러
		assertThat(-7).isPositive();	// 에러
	}
	
	@Test
	void tt6() {
		System.out.println("숫자 tt6 진입");
		assertThat(-7).isNegative();	// 음수인가? n < 0
		assertThat(0).isNegative();		// 에러
		assertThat(7).isNegative();		// 에러
	}
	
	@Test
	void tt7() {
		System.out.println("숫자 tt7 진입");
		assertThat(0).isZero();		// 0 == 0
//		assertThat(1).isZero();		// 1 == 0
		
		assertThat(1).isNotZero();		// 1 != 0
		assertThat(0).isNotZero();		// 0 != 0
	}
	
	
}
