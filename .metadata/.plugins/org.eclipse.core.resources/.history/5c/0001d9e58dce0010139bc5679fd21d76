package control_p;

public class ForMain {

	public static void main(String[] args) {
		System.out.println("아기상어");
		System.out.println();
		System.out.println("엄마상어");
		
		System.out.print("상어");
		System.out.print("고래");
//		System.out.print();
		System.out.print("문어");
		System.out.println();
		
		for(int i=0; i<5; i++) {
			for (int j=0; j<=i; j++) {
				System.out.print("*");
			}
			System.out.println();
		}
	}

}
